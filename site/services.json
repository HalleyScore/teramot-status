    {
      "id": "app",
      "name": "Aplicación web",
      "description": "app.teramot.com",
      "url": "https://app.teramot.com/",
      "expect": {
        "contains": [
          "<div id=\"root\"",
          "/assets/index-"
        ]
      }
    },
    {
      "id": "api",
      "name": "API",
      "description": "Servicio de datos y consultas",
      "url": "https://aleph.teramot.com/health",
      "expect": {
        "json": {
          "data.status": "ok",
          "data.database": "ok"
        }
      }
    },
    {
      "id": "mcp",
      "name": "MCP",
      "description": "Conector para Claude, ChatGPT y otros agentes",
      "url": "https://mcp.teramot.com/health"
    },
    {
      "id": "auth",
      "name": "Autenticación",
      "description": "Inicio de sesión y cuentas",
      "url": "https://auth.teramot.com/api/status"
    },
    {
      "id": "docs",
      "name": "Documentación",
      "description": "docs.teramot.com",
      "url": "https://docs.teramot.com/"
    },
    {
      "id": "engineering",
      "name": "Blog de ingeniería",
      "description": "engineering.teramot.com",
